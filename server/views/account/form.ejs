<form class="account-form">
  <div class="errors" id="errors"></div>

  <div class="field-group">
    <label for="firstName">First Name</label>
    <input type="text"
      id="firstName"
      name="firstName"
      class="form-control"
      maxLength="32"
      required />
  </div>

  <div class="field-group">
    <label for="lastName">Last Name</label>
    <input type="text"
      id="lastName"
      name="lastName"
      class="form-control"
      maxLength="32"
      required />
  </div>

  <div class="field-group">
    <label for="email">Email</label>
    <input type="email"
      id="email"
      name="email"
      class="form-control"
      required />
  </div>

  <div class="field-group password-message">
    <p class="field-info">Leave the passwords blank below unless you want to update them.</p>
  </div>

  <div class="field-group">
    <label for="password">Password</label>
    <p class="field-info">Please pick a good password - preferably one you haven't used somewhere else.</p>
    <input type="password"
      id="password"
      name="password"
      class="form-control"
      minlength="8"
      maxLength="255"
      />
  </div>

  <div class="field-group">
    <label for="confirmPassword">Confirm Password</label>
    <p class="field-info">Please type the password one more time to make sure we've both got it correct.</p>
    <input type="password"
      id="confirmPassword"
      name="confirmPassword"
      class="form-control"
      minlength="8"
      maxLength="255"
      />
  </div>

  <div class="button-group">
    <input
      id="save-button"
      type="submit"
      class="submit button save-button"
      value="Save" />
  </div>

</form>