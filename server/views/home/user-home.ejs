<div class="bwmd-wrapper block-wrapper">
  <section class="bwmd">
    <header class="bwmd-header">
      <h2 class="bwmd-title">Be Well My Darlings</h2>
    </header>
    <article class="bwmd-content">
      <% for(paragraph of bwmd.split('\n')) { %>
        <% if(paragraph.length) { %>
          <p><%= paragraph %></p>
        <% } %>
      <% } %>
      <p> - <a href="https://www.jacsfishburne.com/">Jacs Fishburne</a></p>
    </article>
  </section>
</div>
<div class="jobs-wrapper block-wrapper">
  <section class="jobs">
    <header class="content-header">
      <h1>Jobs</h1>
      <a href="<%= calendarUrl %>" title="Don't download this file, instead copy this link and subscribe to it in your calendar app!"><span class="icon far fa-calendar"></span></a>
    </header>
      <button class="button button-add jobs-button-add info-button" id="new-job-button">
        <span class="icon"></span>
        New Job
      </button>
    <section id="jobs-list" class="jobs-list"></section>
  </section>
</div>
