<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

  <link rel="stylesheet" href="/assets/css/style.css"/>
  <title><%= title %>Job.Hunt.Works</title>
</head>
<body>
  <header class="page-header">
    <nav class="navbar navbar-expand-lg">
      <a href="/" class="nav-link"><span class="navbar-brand">Job.Hunt.Works</span></a>

      <div class="collapse navbar-collapse menu-links" id="navbarSupportedContent">
        <ul class="navbar-nav main-nav">
          <% if ( user && user.isAdmin ) { %>
            <li class="nav-item">
              <a href="/admin/" class="nav-link">Admin</a>
            </li>
            <li class="nav-item">
              <a href="/admin/users/" class="nav-link">Users</a>
            </li>
            <li class="nav-item">
              <a href="/admin/userlevels/" class="nav-link">User Levels</a>
            </li>
            <li class="nav-item">
              <a href="/admin/actions/" class="nav-link">Actions</a>
            </li>
          <% } %>
        </ul>
        <ul class="navbar-nav user-nav">
          <% if ( user ) { %>
            <li class="nav-item">
              <a href="/account/" class="nav-link">My Account</a>
            </li>
            <li class="nav-item">
              <a href="/logout/" class="nav-link">Logout</a>
            </li>
          <% } else { %>
            <li class="nav-item">
              <a href="/signup/" class="nav-link">Signup</a>
            </li>
            <li class="nav-item">
              <a href="/login/" class="nav-link">Login</a>
            </li>
          <% } %>
        </ul>
      </div>
    </nav>
  </header>

  <main class="page-main">
    <section id="modal" class="modal hidden">
      <div class="modal-inside">
        <a class="modal-closer" id="modal-closer" title="Close Window">x</a>
        <div class="modal-content" id="modal-content"></div>
      </div>
    </section>