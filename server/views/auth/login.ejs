<%- include('../partials/header.ejs', {'title': 'Login - '}); -%>

<section class="login-form block-wrapper">
  <header>
    <h1>Login</h1>
  </header>
  <form method="POST">
    <% if(errors) { %>
      <div class="field-group errors login-form-errors">
        <ul>
          <% for(var i=0; i < errors.length; i++) { %>
            <li><%= errors[i] %></li>
          <% } %>
        </ul>
      </div>
    <% } %>

    <div class="field-group">
      <label htmlFor="email">Email</label>
      <input
        name="email"
        id="email"
        class="form-control"
        type="email"
        required
      />
    </div>

    <div class="field-group">
      <label htmlFor="password">Password</label>
      <input
        name="password"
        id="password"
        type="password"
        class="form-control"
        required
      />
    </div>

    <div class="field-group login-form-submit-group">
      <input
        type="submit"
        name="submit"
        value="Login"
        class="login-form-submit button save-button"
      />

      <a href="/forgotpassword/" class="login-form-reset">
        Reset My Password</a>
    </div>
  </form>
</section>

<%- include('../partials/footer.ejs') %>