<% layout('layout') -%>

<div id="root">
  <h1>Job.Hunt.Works</h1>
  <section class="login-form block-wrapper">
    <header>
      <h1>Login</h1>
    </header>
    <form method="POST">
      <% if(errors) { %>
        <div class="field-group errors login-form-errors">
          <ul>
            <% for(var i=0; i < errors.length; i++) { %>
              <li><%= errors[i] %></li>
            <% } %>
          </ul>
        </div>
      <% } %>

      <div class="field-group">
        <label htmlFor="email">Email</label>
        <input
          name="email"
          id="email"
          type="email"
          required
        />
      </div>

      <div class="field-group">
        <label htmlFor="password">Password</label>
        <input
          name="password"
          id="password"
          type="password"
          required
        />
      </div>

      <div class="field-group login-form-submit-group">
        <input
          type="submit"
          name="submit"
          value="Login"
          class="login-form-submit"
        />

        <a href="/forgotpassword/" class="login-form-reset">
          Reset My Password</a>
      </div>
    </form>
  </section>
</div>