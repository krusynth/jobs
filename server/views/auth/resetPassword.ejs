<%- include('../partials/header.ejs', {'title': 'Reset Password - '}); -%>

<section class="login-form block-wrapper">
  <header>
    <h1>Reset Password</h1>
  </header>
  <form method="POST" class="reset-password-form">
    <div class="errors" id="errors"></div>

    <input type="hidden" name="token" value="<%= token %>">

    <div class="field-group">
      <label for="password">Password</label>
      <p class="field-info">Please pick a good password - preferably one you haven't used somewhere else.</p>
      <input type="password"
        id="password"
        name="password"
        class="form-control"
        minlength="8"
        maxLength="255"
        required
        />
    </div>

    <div class="field-group">
      <label for="confirmPassword">Confirm Password</label>
      <p class="field-info">Please type the password one more time to make sure we've both got it correct.</p>
      <input type="password"
        id="confirmPassword"
        name="confirmPassword"
        class="form-control"
        minlength="8"
        maxLength="255"
        required
        />
    </div>

      <div class="field-group login-form-submit-group">
        <input
          type="submit"
          name="submit"
          value="Change Password"
          class="button save-button"
      />

    </div>
  </form>
</section>

<%- include('../partials/footer.ejs') %>